# ---- Graph storage ------------------------------------------------------------
# in_memory = no database needed (graphs persisted as gzip JSON in DATA_DIR)
# neo4j     = persistent graph database (start it with: docker compose up -d neo4j)
GRAPH_BACKEND=in_memory
DATA_DIR=./data
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# ---- Repository acquisition -----------------------------------------------------
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
CLONE_TIMEOUT_SECONDS=180
MAX_REPO_MB=1500
MAX_FILE_BYTES=1000000
MAX_FILES=25000
# Allow analyzing a folder on this machine (dev only; never enable on a shared server)
ALLOW_LOCAL_PATHS=false
KEEP_CLONES=false

# ---- NLP / Gemini (optional: without a key the deterministic rule planner is used) ----
NLP_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NLP_EXPLAIN_WITH_LLM=true
NLP_REQUEST_TIMEOUT_SECONDS=30
NLP_MAX_HOPS=6

# ---- API -------------------------------------------------------------------------------
# Set API_KEY to require the X-API-Key header on every /api call (recommended when deployed)
API_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_ANALYZE_PER_MIN=6
RATE_LIMIT_ASK_PER_MIN=40
ANALYSIS_WORKERS=2
MAX_VIEW_NODES=150
HARD_MAX_NODES=600

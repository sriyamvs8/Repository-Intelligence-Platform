<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.repo.OrderMapper">
  <select id="selectById" resultType="com.shop.model.Order">
    SELECT id, sku, quantity, status FROM orders WHERE id = #{id}
  </select>
</mapper>
